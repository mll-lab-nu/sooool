{
  "sources": {
    "roboolympics": {
      "repository": "https://github.com/CHIGUI0/roboolympics.git",
      "revision": "da1f787f775ea6524d698c0b063157ded4c0fef9"
    },
    "vera20k": {
      "repository": "https://github.com/mindorigin150/vera20k-agent.git",
      "revision": "c9a9b38f2e42042f398a39a4f07edcd0feba0219"
    },
    "pvz": {
      "repository": "https://github.com/mindorigin150/PvZ-Portable-agent.git",
      "revision": "619afa2459c5493fedf0c5e4db34287a876d2a1c"
    }
  },
  "aliases": {"pingpong": "tabletennis"},
  "games": {
    "asterix": {
      "kind": "local",
      "python": "3.12",
      "browser": false,
      "requirements": "environments/asterix/requirements.txt",
      "runner": "scripts/asterix.py",
      "commands": ["simulate", "eval"]
    },
    "tetris": {
      "kind": "local",
      "python": "3.12",
      "browser": false,
      "requirements": "environments/tetris/requirements.txt",
      "runner": "scripts/tetris.py",
      "commands": ["simulate", "eval", "replay"]
    },
    "touhou": {
      "kind": "local",
      "python": "3.12",
      "browser": true,
      "requirements": "environments/touhou/requirements.txt",
      "runner": "scripts/touhou.py",
      "commands": ["simulate", "eval", "profile"],
      "install_metadata": ["environments/touhou/pyproject.toml"]
    },
    "rhythm": {
      "kind": "local",
      "python": "3.12",
      "browser": true,
      "requirements": "environments/rhythm/requirements.txt",
      "runner": "scripts/rhythm.py",
      "commands": ["simulate", "eval", "profile"],
      "install_metadata": ["environments/rhythm/pyproject.toml"]
    },
    "racing": {
      "kind": "external",
      "source": "roboolympics",
      "python": "3.12",
      "requirements": "environments/racing/requirements.txt",
      "runner": "scripts/racing.py",
      "variables": {"MUJOCO_GL": "egl", "LP_NUM_THREADS": "1", "PYTHONDONTWRITEBYTECODE": "1"},
      "commands": ["simulate", "eval", "profile", "preflight", "budget"],
      "source_variable": "RACING_ENV_ROOT"
    },
    "badminton": {
      "kind": "external",
      "source": "roboolympics",
      "python": "3.11",
      "requirements": "environments/badminton/requirements.txt",
      "runner": "scripts/badminton.py",
      "variables": {"OPENBLAS_NUM_THREADS": "1", "OMP_NUM_THREADS": "1"},
      "commands": ["simulate", "eval", "preflight", "audit", "report", "diagnose", "profile"],
      "source_variable": "BADMINTON_ENV_ROOT"
    },
    "tabletennis": {
      "kind": "external",
      "source": "roboolympics",
      "python": "3.11",
      "requirements": "environments/tabletennis/requirements.txt",
      "runner": "scripts/tabletennis.py",
      "commands": ["simulate", "eval", "report"],
      "source_variable": "TABLETENNIS_ENV_ROOT"
    },
    "vera20k": {
      "kind": "external",
      "source": "vera20k",
      "python": "3.12",
      "setup": "environments/vera20k/setup.sh"
    },
    "pvz": {
      "kind": "external",
      "source": "pvz",
      "python": "3.12",
      "setup": "environments/pvz/setup.sh"
    },
    "pcba": {
      "kind": "local",
      "python": "3.11",
      "requirements": "environments/pcba/requirements.txt",
      "runner": "scripts/pcba.py",
      "commands": ["eval", "report", "demo", "realtime-smoke", "view", "latency", "pipeline", "loop-demo", "simulate", "export", "showcase", "figures", "clock-preflight"]
    }
  }
}
